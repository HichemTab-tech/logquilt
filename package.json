{
    "name": "logquilt",
    "version": "1.0.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts --dev",
        "build": "pnpm typecheck && vite build",
        "assets:brand": "tsx scripts/generate-brand-assets.ts",
        "start": "tsx server.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:e2e": "vitest run --project browser",
        "test:watch": "vitest --project unit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm format:check && pnpm typecheck && pnpm test"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "@tanstack/react-virtual": "^3.14.26",
        "diff": "^9.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "playwright": "^1.65.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@12.15.0"
}
